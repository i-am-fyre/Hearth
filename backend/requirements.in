# Hearth's direct backend dependencies, with the version ranges we support.
#
# requirements.txt is generated from this file and pins every package (including
# transitive ones) so Docker and release builds install exactly what was tested.
# After editing this file, regenerate it from the backend/ directory with:
#
#   uv pip compile requirements.in --universal --python-version 3.11 -o requirements.txt
#
# To pick up newer versions within these ranges, add --upgrade.

