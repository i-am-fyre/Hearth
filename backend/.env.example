# Copy to backend/.env and fill in what you need. Every value is optional for
# local development with `docker compose up`.

# Signs login tokens. Leave unset and Hearth generates one and saves it to
# backend/.secret_key. To set your own:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Database. docker-compose.yml already points the backend at its Postgres service.
# DATABASE_URL=postgresql://hearth:postgres@db:5432/hearth

# Google Gemini key for AI receipt parsing (falls back to Tesseract OCR).
# GEMINI_API_KEY=

# Email for household invites and password resets. Without SMTP, reset links
# are written to the backend log instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# FRONTEND_URL=http://localhost:5173
